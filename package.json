{
  "name": "biggtaal",
  "productName": "BiggTaal",
  "version": "0.4.0",
  "private": true,
  "description": "A cute dark Dutch learning app: flashcards, worksheets, listening, lesson reminders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "node scripts/get-voices.js && electron-builder --win nsis --publish never",
    "voices": "node scripts/get-voices.js",
    "install:local": "node scripts/install-local.js",
    "ship:local": "npm run dist && node scripts/install-local.js"
  },
  "build": {
    "appId": "com.laurmoe.biggtaal",
    "productName": "BiggTaal",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "BiggTaal-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "voices",
        "to": "voices",
        "filter": [
          "piper/**/*",
          "models/*.onnx",
          "models/*.onnx.json"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "laurmoe7",
        "repo": "bigg-taal"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
